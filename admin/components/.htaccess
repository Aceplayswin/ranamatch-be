<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ==========================================
  # 1. API SUBDOMAIN (api.ranamatch.com)
  # ==========================================

  # Fix for missing trailing slashes (prevents revealing the /api/ folder)
  RewriteCond %{HTTP_HOST} ^api\.ranamatch\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}/$1 -d
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # A) Serve admin, security, uploads, storage from api/ folder
  RewriteCond %{HTTP_HOST} ^api\.ranamatch\.com$ [NC]
  RewriteRule ^(admin|security|uploads|storage)/(.*)$ api/$1/$2 [QSA,L]

  # B) Game callback: Rewrite /game/ to the actual file path
  RewriteCond %{HTTP_HOST} ^api\.ranamatch\.com$ [NC]
  RewriteRule ^game/?$ api/game/index.php [QSA,L]
  RewriteCond %{HTTP_HOST} ^api\.ranamatch\.com$ [NC]
  RewriteRule ^game/(.*)$ api/game/index.php [QSA,L]

  # C) API ROUTER: Send everything else to api/router/index.php
  RewriteCond %{HTTP_HOST} ^api\.ranamatch\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ api/router/index.php [QSA,L]


  # ==========================================
  # 2. MAIN DOMAIN FRONTEND (ranamatch.com)
  # ==========================================

  # A) Game callback on main domain
  RewriteRule ^game/?$ api/game/index.php [QSA,L]
  RewriteRule ^game/(.*)$ api/game/index.php [QSA,L]

  # B) API Router on Main Domain
  # Allow direct file access first (e.g., /api/router/index.php?Route=...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # C) Rewrite /api/ paths to api/router/index.php
  RewriteRule ^api/(.*)$ api/router/index.php [QSA,L]

  # D) Route non-existent files to the React SPA (index.html)
  RewriteCond %{HTTP_HOST} !^api\.ranamatch\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]

</IfModule>