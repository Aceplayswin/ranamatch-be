<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # 1. Serve existing folders (like admin/ or uploads/) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Send everything else to the API router
  RewriteRule ^(.*)$ router/index.php [QSA,L]
</IfModule>
