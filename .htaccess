<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ==========================================
  # CORS Headers (Allowing velplay365.com & Subdomains & Local Dev Ports)
  # ==========================================
  <IfModule mod_headers.c>
    SetEnvIf Origin "^(https?://(localhost|127\.0\.0\.1)(:[0-9]+)?|https://(api\.|agent\.|affiliate\.)?velplay365\.com)$" CORS_ORIGIN=$0
    Header set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE" env=CORS_ORIGIN
    Header set Access-Control-Allow-Headers "Origin, Content-Type, Accept, Route, route, AuthToken, authToken, Authtoken, authtoken, USER_ID, user_id, Authorization" env=CORS_ORIGIN
    Header set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    Header set Access-Control-Max-Age "3600" env=CORS_ORIGIN
  </IfModule>

  # ==========================================
  # 1. Do Not Rewrite Real Static Files
  # (JS, CSS, Images, Fonts, Zips, Webmanifest)
  # ==========================================
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webmanifest|json|zip)$ - [L]

  # ==========================================
  # 2. API & Router Requests (FORCE ROUTE TO router/index.php)
  # Overrides physical directory checks for /agent/*, /affiliate/*, /api/*, /game/*
  # Supports both direct domain and /api1/ subfolder paths on live server
  # ==========================================
  RewriteRule ^api1/agent/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/agent$ router/index.php [QSA,L]
  RewriteRule ^api1/affiliate/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/affiliate$ router/index.php [QSA,L]
  RewriteRule ^api1/v1/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/api/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/game/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/admin/agents/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/admin/affiliates/(.*)$ router/index.php [QSA,L]
  RewriteRule ^api1/route-(.*)$ router/index.php [QSA,L]

  RewriteRule ^api/(.*)$ router/index.php [QSA,L]
  RewriteRule ^agent/(.*)$ router/index.php [QSA,L]
  RewriteRule ^agent$ router/index.php [QSA,L]
  RewriteRule ^affiliate/(.*)$ router/index.php [QSA,L]
  RewriteRule ^affiliate$ router/index.php [QSA,L]
  RewriteRule ^admin/agents/(.*)$ router/index.php [QSA,L]
  RewriteRule ^admin/affiliates/(.*)$ router/index.php [QSA,L]
  RewriteRule ^game/(.*)$ router/index.php [QSA,L]
  RewriteRule ^route-(.*)$ router/index.php [QSA,L]

  # ==========================================
  # 3. Subdomain SPA Handling (agent.velplay365.com & affiliate.velplay365.com)
  # ==========================================
  RewriteCond %{HTTP_HOST} ^agent\.velplay365\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ agent/index.html [L]

  RewriteCond %{HTTP_HOST} ^affiliate\.velplay365\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ affiliate/index.html [L]

  # ==========================================
  # 4. Direct Access to Real PHP Files & Directories (Admin, Uploads, Security)
  # ==========================================
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ==========================================
  # 5. Main Single Page App (index.html fallback)
  # ==========================================
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]

</IfModule>